# Valores para rodar fora do profile `local` (que sobe o docker-compose.yml e preenche tudo sozinho).
# No cluster: ConfigMap/Secret preenchidos pelo pipeline; sem chave AWS (os pods usam a LabRole).

# PostgreSQL. Deploy: output databases["orders"] do mechanical-hub-database; senha no secret ORDERS_DB_APP_PASSWORD
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mechanical_hub_orders
DB_USERNAME=orders_app
DB_PASSWORD=orders_app

# SQS. Deploy: outputs sqs_queue_urls / sqs_dlq_urls do mechanical-hub-infra
AWS_REGION=us-east-1
ORDERS_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-orders-commands.fifo
ORDERS_COMMANDS_DLQ_URL=http://localhost:4566/000000000000/mechanical-hub-orders-commands-dlq.fifo
ORCHESTRATOR_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-orchestrator-events.fifo
OUTBOX_RELAY_ENABLED=true

# Link de aprovacao enviado ao cliente. Deploy: variavel FRONTEND_BASE_URL do repositorio
FRONTEND_BASE_URL=http://localhost:3000

# Ambiente (rotulo de logs e metricas)
ENVIRONMENT=local

# OpenTelemetry. Deploy: output otlp_http_endpoint (sem coletor: none)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=none
